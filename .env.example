# FieldOps AI Environment Configuration Template
# Copy this file to .env and adjust variables as needed

# Application
PROJECT_NAME="FieldOps AI"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"

# MongoDB Configuration
MONGODB_URL="mongodb://localhost:27017"
MONGODB_DB_NAME="fieldops_dev"
MONGODB_MIN_POOL_SIZE=10
MONGODB_MAX_POOL_SIZE=50
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Redis & Celery Configuration
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# Integration Adapters ("mock" for zero-cost deterministic dev/test, or real provider names)
NOTIFICATION_PROVIDER="mock"
MAPS_PROVIDER="mock"
CALENDAR_PROVIDER="mock"
CRM_PROVIDER="mock"
VOICE_STT_PROVIDER="mock"
VOICE_TTS_PROVIDER="mock"
LLM_PROVIDER="mock"

# LLM & Voice Credentials (leave blank to use deterministic offline mocks)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_VOICE_MODEL="whisper-1"

# Webhooks & Signatures
WEBHOOK_SIGNING_SECRET="dev-webhook-secret-signing-key-32chars"
WEBHOOK_TOLERANCE_SECONDS=300

# Optional External Provider Credentials (leave blank to use deterministic mocks)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL="notifications@fieldops.ai"

# Transactional Outbox Worker
OUTBOX_MAX_RETRIES=5
OUTBOX_BASE_BACKOFF_SECONDS=2.0
OUTBOX_MAX_BACKOFF_SECONDS=300.0
OUTBOX_BATCH_SIZE=50

# JWT Authentication & Security
JWT_SECRET_KEY="replace-this-in-production-with-a-secure-random-32-byte-hex-string"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Configuration (JSON array of allowed origins)
CORS_ORIGINS='["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]'

# Operational & Observability
LOG_FORMAT="text"                 # "text" for human-readable dev logs, "json" for structured production aggregation
RATE_LIMIT_ENABLED=true           # In-memory sliding-window request throttling
RATE_LIMIT_PER_MINUTE=120         # Maximum requests per minute per IP
REQUEST_TIMEOUT_SECONDS=30.0      # Maximum request execution timeout

# Agent Safeguards & Session Management
CONVERSATION_HISTORY_LIMIT=20
AGENT_TIMEOUT_SECONDS=15.0
PROMPT_INJECTION_STRICT_MODE=true

# Default Administrator Seed Account
SEED_ADMIN_EMAIL="admin@fieldops.ai"
SEED_ADMIN_PASSWORD="AdminSecurePassword123!"
